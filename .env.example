DEEPGUARD_APP_NAME=DeepGuard AI
DEEPGUARD_API_PREFIX=/api
DEEPGUARD_DATABASE_URL=sqlite:///./deepguard.db
DEEPGUARD_UPLOAD_DIR=uploads
DEEPGUARD_REPORT_DIR=reports
DEEPGUARD_MODEL_DIR=models
DEEPGUARD_MODEL_PATH=models/deepguard_baseline.pt
DEEPGUARD_MODEL_NAME=efficientnet_b0_baseline
DEEPGUARD_MAX_UPLOAD_MB=150
DEEPGUARD_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
DEEPGUARD_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv,webm
DEEPGUARD_VIDEO_SAMPLE_FPS=2.0
DEEPGUARD_MAX_VIDEO_FRAMES=48
DEEPGUARD_FRAME_SCORE_THRESHOLD=0.62
DEEPGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

